{
  "id": "osint-realm",
  "realm": "osint-realm",
  "displayName": "OSINT Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role - full access to trigger collectors and view all data"
      },
      {
        "name": "viewer",
        "description": "Viewer role - read-only access to search, dashboards and metrics"
      },
      {
        "name": "admins",
        "description": "Composite role mapped from LDAP admins group",
        "composite": true,
        "composites": {
          "realm": ["admin"]
        }
      },
      {
        "name": "viewers",
        "description": "Composite role mapped from LDAP viewers group",
        "composite": true,
        "composites": {
          "realm": ["viewer"]
        }
      }
    ]
  },
  "groups": [
    {
      "name": "admins",
      "path": "/admins",
      "realmRoles": ["admin"]
    },
    {
      "name": "viewers",
      "path": "/viewers",
      "realmRoles": ["viewer"]
    }
  ],
  "users": [
    {
      "username": "local_admin",
      "enabled": true,
      "email": "local_admin@osint.local",
      "firstName": "Local",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "LocalAdmin123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "local_viewer",
      "enabled": true,
      "email": "local_viewer@osint.local",
      "firstName": "Local",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "LocalViewer123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "osint-frontend",
      "name": "OSINT Frontend Application",
      "description": "Angular SPA Client with PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4200"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:4200"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "osint-backend",
      "name": "OSINT Backend API",
      "description": ".NET Web API Resource Server",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "ldap-openldap-provider",
        "name": "openldap",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "id": "ldap-username-mapper",
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["uid"],
                "is.mandatory.in.ldap": ["true"],
                "always.read.value.from.ldap": ["false"],
                "read.only": ["true"],
                "user.model.attribute": ["username"]
              }
            },
            {
              "id": "ldap-first-name-mapper",
              "name": "first-name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["givenName"],
                "is.mandatory.in.ldap": ["false"],
                "always.read.value.from.ldap": ["false"],
                "read.only": ["true"],
                "user.model.attribute": ["firstName"]
              }
            },
            {
              "id": "ldap-last-name-mapper",
              "name": "last-name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "is.mandatory.in.ldap": ["true"],
                "always.read.value.from.ldap": ["false"],
                "read.only": ["true"],
                "user.model.attribute": ["lastName"]
              }
            },
            {
              "id": "ldap-email-mapper",
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "is.mandatory.in.ldap": ["false"],
                "always.read.value.from.ldap": ["false"],
                "read.only": ["true"],
                "user.model.attribute": ["email"]
              }
            },
            {
              "id": "ldap-role-mapper",
              "name": "roles",
              "providerId": "role-ldap-mapper",
              "config": {
                "roles.dn": ["ou=groups,dc=osint,dc=local"],
                "role.name.ldap.attribute": ["cn"],
                "role.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_ROLES_BY_MEMBER_ATTRIBUTE"],
                "use.realm.roles.mapping": ["true"]
              }
            },
            {
              "id": "ldap-groups-mapper",
              "name": "groups",
              "providerId": "group-ldap-mapper",
              "config": {
                "groups.dn": ["ou=groups,dc=osint,dc=local"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "mode": ["READ_ONLY"],
                "groups.user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"],
                "drop.non.existing.groups.during.sync": ["false"]
              }
            }
          ]
        },
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "editMode": ["READ_ONLY"],
          "syncRegistrations": ["false"],
          "vendor": ["other"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson, organizationalPerson, person"],
          "connectionUrl": ["ldap://openldap:389"],
          "usersDn": ["ou=users,dc=osint,dc=local"],
          "authType": ["simple"],
          "bindDn": ["cn=admin,dc=osint,dc=local"],
          "bindCredential": ["adminpassword"],
          "searchScope": ["1"],
          "validatePasswordPolicy": ["false"],
          "trustEmail": ["true"],
          "connectionTimeout": ["5000"],
          "readTimeout": ["10000"],
          "pagination": ["true"]
        }
      }
    ]
  }
}
