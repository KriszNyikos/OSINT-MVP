# ==============================================================================
# OSINT Platform MVP - Docker Environment Configuration
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=osint-mvp

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_secure_password_dev
MYSQL_APP_DATABASE=osint_db
MYSQL_KEYCLOAK_DATABASE=keycloak_db
MYSQL_USER=osint_user
MYSQL_PASSWORD=osint_db_password_dev

# ------------------------------------------------------------------------------
# OpenLDAP (Test Directory) Configuration
# ------------------------------------------------------------------------------
LDAP_PORT=389
LDAP_ORGANISATION=OSINT Platform
LDAP_DOMAIN=osint.local
LDAP_BASE_DN=dc=osint,dc=local
LDAP_ADMIN_PASSWORD=adminpassword

# ------------------------------------------------------------------------------
# Keycloak IAM Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password_dev
KEYCLOAK_REALM=osint-realm
